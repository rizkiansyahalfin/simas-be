{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "types": ["node", "jest"],

    "typeRoots": ["./src/types", "./node_modules/@types"]
  },

  "include": ["src", "src/types"],

  "exclude": ["node_modules", "dist"]
}