generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  superadmin
  bendahara
  admin_kegiatan
  admin_inventaris
}

enum TransactionType {
  income
  expense
}

enum ZisCategory {
  zakat
  infaq
  shadaqah
}

enum DonationStatus {
  pending
  verified
  rejected
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum InventoryCondition {
  baik
  rusak_ringan
  rusak_berat
  hilang
}

enum LoanStatus {
  borrowed
  returned
  overdue
}

enum Gender {
  male
  female
}

enum MustahikCategory {
  fakir
  miskin
  amil
  muallaf
  riqab
  gharim
  fisabilillah
  ibnu_sabil
}

enum CampaignStatus {
  active
  completed
  cancelled
  draft
}

enum AuditAction {
  create
  update
  delete
}

enum NotificationType {
  donation
  event
  inventory
  campaign
  system
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  articles          Article[]
  cashTransactions  CashTransaction[]
  zisTransactions   ZisTransaction[]
  donationsVerified Donation[]        @relation("DonationVerifier")
  events            Event[]
  jumatSchedules    JumatSchedule[]
  inventories       Inventory[]
  inventoryLoans    InventoryLoan[]
  galleries         Gallery[]
  campaigns         Campaign[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Article {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  content     String    @db.Text
  imageUrl    String?   @map("image_url") @db.VarChar(255)
  authorId    Int       @map("author_id")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id])

  @@map("articles")
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  userId     Int?        @map("user_id")
  action     AuditAction
  module     String      @db.VarChar(100)
  entityId   String?     @map("entity_id") @db.VarChar(100)
  ipAddress  String?     @map("ip_address") @db.VarChar(100)
  userAgent  String?     @map("user_agent") @db.Text
  beforeData Json?       @map("before_data")
  afterData  Json?       @map("after_data")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Campaign {
  id           Int            @id @default(autoincrement())
  title        String         @db.VarChar(255)
  description  String?        @db.Text
  targetAmount Decimal        @map("target_amount") @db.Decimal(15, 2)
  thumbnailUrl String?        @map("thumbnail_url") @db.VarChar(255)
  deadline     DateTime?      @db.Date
  status       CampaignStatus @default(draft)
  createdBy    Int            @map("created_by")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  creator   User       @relation(fields: [createdBy], references: [id])
  donations Donation[]

  @@map("campaigns")
}

model CashTransaction {
  id              Int             @id @default(autoincrement())
  type            TransactionType
  amount          Decimal         @db.Decimal(15, 2)
  category        String          @db.VarChar(100)
  description     String?         @db.Text
  transactionDate DateTime        @map("transaction_date") @db.Date
  createdBy       Int             @map("created_by")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@map("cash_transactions")
}

model Congregation {
  id         Int      @id @default(autoincrement())
  fullName   String   @map("full_name") @db.VarChar(255)
  nik        String?  @unique @db.VarChar(50)
  address    String?  @db.Text
  phone      String?  @db.VarChar(20)
  gender     Gender?
  birthDate  DateTime? @map("birth_date") @db.Date
  isMustahik Boolean   @default(false) @map("is_mustahik")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  isActive   Boolean   @default(true) @map("is_active")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  mustahik Mustahik?

  @@map("congregations")
}

model Donation {
  id            Int            @id @default(autoincrement())
  donorName     String         @map("donor_name") @db.VarChar(100)
  phone         String?        @db.VarChar(20)
  amount        Decimal        @db.Decimal(15, 2)
  category      String         @db.VarChar(100)
  proofImageUrl String?        @map("proof_image_url") @db.VarChar(255)
  status        DonationStatus @default(pending)
  verifiedBy    Int?           @map("verified_by")
  verifiedAt    DateTime?      @map("verified_at")
  rejectionNote String?        @map("rejection_note") @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  campaignId    Int?           @map("campaign_id")

  verifier User?     @relation("DonationVerifier", fields: [verifiedBy], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("donations")
}

model Event {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(255)
  description String?     @db.Text
  speaker     String?     @db.VarChar(100)
  location    String?     @db.VarChar(255)
  startTime   DateTime    @map("start_time")
  endTime     DateTime    @map("end_time")
  status      EventStatus @default(upcoming)
  createdBy   Int         @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@map("events")
}

model Gallery {
  id         Int      @id @default(autoincrement())
  title      String?  @db.VarChar(255)
  caption    String?  @db.Text
  imageUrl   String   @map("image_url") @db.VarChar(255)
  uploadedBy Int      @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  uploader User @relation(fields: [uploadedBy], references: [id])

  @@map("galleries")
}

model Inventory {
  id              Int                @id @default(autoincrement())
  itemCode        String             @map("item_code") @db.VarChar(50)
  itemName        String             @map("item_name") @db.VarChar(255)
  category        String             @db.VarChar(100)
  quantity        Int
  condition       InventoryCondition @default(baik)
  acquiredDate    DateTime?          @map("acquired_date") @db.Date
  acquisitionCost Decimal?           @map("acquisition_cost") @db.Decimal(15, 2)
  notes           String?            @db.Text
  managedBy       Int                @map("managed_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  manager       User            @relation(fields: [managedBy], references: [id])
  inventoryLoans InventoryLoan[]

  @@map("inventories")
}

model InventoryCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory_categories")
}

model InventoryLoan {
  id                 Int        @id @default(autoincrement())
  inventoryId        Int        @map("inventory_id")
  borrowerName       String     @map("borrower_name") @db.VarChar(100)
  borrowerPhone      String?    @map("borrower_phone") @db.VarChar(20)
  loanDate           DateTime   @map("loan_date") @db.Date
  expectedReturnDate DateTime   @map("expected_return_date") @db.Date
  actualReturnDate   DateTime?  @map("actual_return_date") @db.Date
  status             LoanStatus @default(borrowed)
  notes              String?    @db.Text
  createdBy          Int        @map("created_by")
  createdAt          DateTime   @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  creator   User     @relation(fields: [createdBy], references: [id])

  @@map("inventory_loans")
}

model JumatSchedule {
  id          Int      @id @default(autoincrement())
  jumatDate   DateTime @map("jumat_date") @db.Date
  imam        String?  @db.VarChar(100)
  khatib      String?  @db.VarChar(100)
  muadzin     String?  @db.VarChar(100)
  temaKhutbah String?  @map("tema_khutbah") @db.Text
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [createdBy], references: [id])

  @@map("jumat_schedules")
}

model MosqueProfile {
  id           Int     @id @default(1)
  name         String  @db.VarChar(255)
  address      String? @db.Text
  description  String? @db.Text
  history      String? @db.Text
  vision       String? @db.Text
  mission      String? @db.Text
  contactPhone String? @map("contact_phone") @db.VarChar(20)
  contactEmail String? @map("contact_email") @db.VarChar(100)
  instagramUrl String? @map("instagram_url") @db.VarChar(255)
  youtubeUrl   String? @map("youtube_url") @db.VarChar(255)
  facebookUrl  String? @map("facebook_url") @db.VarChar(255)
  bankName     String? @map("bank_name") @db.VarChar(100)
  bankAccount  String? @map("bank_account") @db.VarChar(100)
  bankHolder   String? @map("bank_holder") @db.VarChar(100)
  qrisImageUrl String? @map("qris_image_url") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("mosque_profiles")
}

model Mustahik {
  id             Int              @id @default(autoincrement())
  congregationId Int              @unique @map("congregation_id")
  category       MustahikCategory
  notes          String?          @db.Text
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")

  congregation          Congregation           @relation(fields: [congregationId], references: [id])
  mustahikDistributions MustahikDistribution[]

  @@map("mustahiks")
}

model MustahikDistribution {
  id               Int      @id @default(autoincrement())
  mustahikId       Int      @map("mustahik_id")
  zisTransactionId Int      @map("zis_transaction_id")
  amount           Decimal  @db.Decimal(15, 2)
  description      String?  @db.Text
  distributionDate DateTime @map("distribution_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")

  mustahik       Mustahik       @relation(fields: [mustahikId], references: [id])
  zisTransaction ZisTransaction @relation(fields: [zisTransactionId], references: [id])

  @@map("mustahik_distributions")
}

model Notification {
  id         Int              @id @default(autoincrement())
  title      String           @db.VarChar(255)
  message    String           @db.Text
  type       NotificationType
  isRead     Boolean          @default(false) @map("is_read")
  entityId   String?          @map("entity_id") @db.VarChar(100)
  entityType String?          @map("entity_type") @db.VarChar(100)
  uniqueKey  String?          @unique @map("unique_key")
  createdAt  DateTime         @default(now()) @map("created_at")
  readAt     DateTime?        @map("read_at")

  @@map("notifications")
}

model PrayerConfig {
  id        Int      @id @default(1)
  province  String
  city      String
  updatedAt DateTime @updatedAt
}

model PrayerSchedule {
  id         Int      @id @default(autoincrement())
  prayerDate DateTime @map("prayer_date") @db.Date
  city       String   @db.VarChar(100)
  subuh      DateTime? @db.Time
  dzuhur     DateTime? @db.Time
  ashar      DateTime? @db.Time
  maghrib    DateTime? @db.Time
  isya       DateTime? @db.Time
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@unique([prayerDate, city], name: "prayerDate_city")
  @@index([prayerDate, city], name: "idx_prayer_date")
  @@map("prayer_schedules")
}

model ZisTransaction {
  id              Int             @id @default(autoincrement())
  type            TransactionType
  zisCategory     ZisCategory     @map("zis_category")
  amount          Decimal         @db.Decimal(15, 2)
  muzakkiName     String?         @map("muzakki_name") @db.VarChar(100)
  description     String?         @db.Text
  transactionDate DateTime        @map("transaction_date") @db.Date
  createdBy       Int             @map("created_by")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  creator               User                   @relation(fields: [createdBy], references: [id])
  mustahikDistributions MustahikDistribution[]

  @@map("zis_transactions")
}
