model RefreshToken {
  id         Int      @id @default(autoincrement())

  token      String   @unique
  userId     Int      @map("user_id")

  expiresAt  DateTime @map("expires_at")

  createdAt  DateTime @default(now()) @map("created_at")

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}