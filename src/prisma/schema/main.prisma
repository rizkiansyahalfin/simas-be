generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums and Configurations are kept here


enum Role {
  superadmin
  bendahara
  admin_kegiatan
  admin_inventaris
}

enum TransactionType {
  income
  expense
}

enum ZisCategory {
  zakat
  infaq
  shadaqah
}

enum DonationStatus {
  pending
  verified
  rejected
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum InventoryCondition {
  baik
  rusak_ringan
  rusak_berat
  hilang
}

enum LoanStatus {
  borrowed
  returned
  overdue
}

enum Gender {
  male
  female
}

enum MustahikCategory {
  fakir
  miskin
  amil
  muallaf
  riqab
  gharim
  fisabilillah
  ibnu_sabil
}
