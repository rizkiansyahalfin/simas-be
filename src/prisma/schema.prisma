// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  superadmin
  bendahara
  admin_kegiatan
  admin_inventaris
}

enum TransactionType {
  income
  expense
}

enum ZisCategory {
  zakat
  infaq
  shadaqah
}

enum DonationStatus {
  pending
  verified
  rejected
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

enum InventoryCondition {
  baik
  rusak_ringan
  rusak_berat
  hilang
}

enum LoanStatus {
  borrowed
  returned
  overdue
}

enum Gender {
  male
  female
}

enum MustahikCategory {
  fakir
  miskin
  amil
  muallaf
  riqab
  gharim
  fisabilillah
  ibnu_sabil
}

enum CampaignStatus {
  active
  completed
  cancelled
  draft
}

enum AuditAction {
  create
  update
  delete
}
enum NotificationType {
  donation
  event
  inventory
  campaign
  system
}